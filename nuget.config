<?xml version="1.0" encoding="utf-8"?>
<!-- Jawne źródło pakietów: kompilacja nie zależy od globalnej konfiguracji NuGet komputera. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
